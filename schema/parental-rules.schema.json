{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ubuntu Parental Control web rules",
  "description": "Open, versioned configuration format for grouped website rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "profile",
    "blocks"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "format_version": {
      "const": "1.0"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "blocks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "default_action",
        "conflict_policy"
      ],
      "properties": {
        "timezone": {
          "$ref": "#/$defs/timezone"
        },
        "default_action": {
          "$ref": "#/$defs/action"
        },
        "conflict_policy": {
          "const": "priority_then_deny",
          "description": "Higher priority wins. If priorities are equal, block wins."
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "enabled",
        "priority",
        "action",
        "user_permissions",
        "targets",
        "exceptions",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable technical ID. IDs must also be unique across blocks."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000,
          "default": 0
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "user_permissions": {
          "$ref": "#/$defs/userPermissions"
        },
        "targets": {
          "$ref": "#/$defs/nonEmptyMatchers"
        },
        "exceptions": {
          "$ref": "#/$defs/matchers"
        },
        "schedule": {
          "$ref": "#/$defs/schedule",
          "description": "If omitted, the block is continuously active."
        },
        "limits": {
          "type": "null",
          "description": "Reserved for a later schema version."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "user_permissions": {
                "properties": {
                  "add_domains": {
                    "const": true
                  }
                },
                "required": [
                  "add_domains"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "block"
              }
            }
          }
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "allow",
        "block"
      ]
    },
    "userPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "add_domains",
        "remove_domains",
        "add_url_patterns",
        "add_url_regex",
        "modify_exceptions",
        "modify_schedule",
        "disable_block"
      ],
      "properties": {
        "add_domains": {
          "type": "boolean",
          "default": false
        },
        "remove_domains": {
          "const": false
        },
        "add_url_patterns": {
          "const": false
        },
        "add_url_regex": {
          "const": false
        },
        "modify_exceptions": {
          "const": false
        },
        "modify_schedule": {
          "const": false
        },
        "disable_block": {
          "const": false
        }
      }
    },
    "matchers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "url_patterns",
        "url_regex"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/domain"
          }
        },
        "url_patterns": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/urlPattern"
          }
        },
        "url_regex": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/urlRegex"
          }
        }
      }
    },
    "nonEmptyMatchers": {
      "allOf": [
        {
          "$ref": "#/$defs/matchers"
        },
        {
          "anyOf": [
            {
              "properties": {
                "domains": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "url_patterns": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "url_regex": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 3,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Lowercase ASCII domain without scheme, port, path or trailing dot. Internationalized domains use Punycode."
    },
    "urlPattern": {
      "type": "string",
      "minLength": 7,
      "maxLength": 2048,
      "pattern": "^(?:\\*|https?)://",
      "description": "WebExtension-style HTTP(S) match pattern. Full semantic validation is performed at runtime."
    },
    "urlRegex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "case_sensitive"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[ -~]+$",
          "description": "Printable ASCII in the RE2 subset supported by declarativeNetRequest."
        },
        "case_sensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "windows"
      ],
      "properties": {
        "timezone": {
          "$ref": "#/$defs/timezone"
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scheduleWindow"
          }
        }
      }
    },
    "scheduleWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "rrule"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/localTime"
        },
        "end": {
          "$ref": "#/$defs/localTime"
        },
        "rrule": {
          "type": "string",
          "pattern": "^FREQ=WEEKLY;BYDAY=(?:MO|TU|WE|TH|FR|SA|SU)(?:,(?:MO|TU|WE|TH|FR|SA|SU))*$",
          "description": "Restricted RFC 5545 weekly recurrence rule. Duplicate weekdays are rejected at runtime."
        }
      }
    },
    "localTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(?:UTC|[A-Za-z_+-]+(?:/[A-Za-z0-9_+.-]+)+)$",
      "description": "IANA time-zone identifier. Runtime validation confirms that it exists."
    }
  }
}
