{
  "manifest_version": 3,
  "name": "Ubuntu Parental Control Webfilter",
  "version": "0.3.6",
  "description": "Verwaltete Browser-Komponente für Ubuntu Parental Control.",
  "icons": {
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "storage": {
    "managed_schema": "managed-policy.schema.json"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "failsafe",
        "enabled": true,
        "path": "rules/failsafe.json"
      }
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
